# Supabase (service role — server-side only, never exposed to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Ollama (local model server)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180

# Shared secret; must match BACKEND_INTERNAL_TOKEN in web/.env.local
INTERNAL_TOKEN=change-me-to-a-long-random-string

# base64 32-byte key for the encrypted per-asset map (must match web).
# Generate: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ASSET_ENCRYPTION_KEY=
