# ── Supabase ────────────────────────────────────────────────────────────
# Project URL + publishable key are safe for the browser; the secret key is
# server-only (used in route handlers / server actions to write through RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ── FastAPI ingest backend ──────────────────────────────────────────────
# Where the Next.js server forwards uploaded scan files for parsing + AI.
BACKEND_URL=http://127.0.0.1:8000
# Shared secret; must match INTERNAL_TOKEN in backend/.env
BACKEND_INTERNAL_TOKEN=change-me-to-a-long-random-string

# ── Porichoy NID verification (Bangladesh National ID) ──────────────────
# Leave PORICHOY_API_KEY empty to run in mock mode outside production (any valid
# 10, 13 or 17 digit NID + DOB passes). In production an empty key blocks verification.
PORICHOY_API_URL=https://porichoy-backend.porichoy.dev/api/v1
PORICHOY_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Email that is auto-promoted to admin + given the first organisation on signup.
BOOTSTRAP_ADMIN_EMAIL=
